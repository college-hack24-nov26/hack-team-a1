  "typography": {
    "fontSans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontMono": "'JetBrains Mono', Consolas, monospace",
    "sizes": {
      "label": "11px",
      "small": "12px",
      "body": "14px",
      "h3": "16px",
