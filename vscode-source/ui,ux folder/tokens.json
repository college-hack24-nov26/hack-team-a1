{
  "name": "BuildLab Figma Tokens (Hackathon 2K26 - Node 9-404)",
  "version": "2.0.0",
  "theme": "Figma Technical Precision",
  "colors": {
    "background": {
      "app": "#F6F7F9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#EEF0F3",
      "surfaceActive": "#EAF1FD",
      "terminal": "#12151B"
    },
    "border": {
      "default": "#E1E4E9",
      "input": "#CDD2DA",
      "active": "#2B6BE0",
      "activeBorder": "#D3E3FB",
      "terminal": "#323945"
    },
    "brand": {
      "primary": "#2B6BE0",
      "primaryHover": "#2358BB",
      "monogramBg": "#12151B"
    },
    "lanes": {
      "real": {
        "badgeBg": "#E8F5EC",
        "badgeBorder": "#1F8A4C",
        "badgeText": "#166A3A",
        "label": "Real / Manual Code"
      },
      "hybrid": {
        "badgeBg": "#EAF1FD",
        "badgeBorder": "#D3E3FB",
        "badgeText": "#2358BB",
        "label": "Hybrid Code"
      },
      "vibe": {
        "badgeBg": "#FCEBEA",
        "badgeBorder": "#CF3A33",
        "badgeText": "#A02A25",
        "label": "Vibe Code"
      }
    },
    "status": {
      "pass": {
        "bg": "#E8F5EC",
        "border": "#1F8A4C",
        "text": "#166A3A"
      },
      "advisory": {
        "bg": "#FDF3E1",
        "border": "#B7791F",
        "text": "#8A5A12"
      },
      "blocker": {
        "bg": "#FCEBEA",
        "border": "#CF3A33",
        "text": "#A02A25"
      }
    },
    "text": {
      "heading": "#12151B",
      "body": "#4B5361",
      "muted": "#6B7482",
      "disabled": "#9AA2AF",
      "inverse": "#FFFFFF",
      "terminalCode": "#D5DAE2",
      "terminalPass": "#8FD0A0"
    }
